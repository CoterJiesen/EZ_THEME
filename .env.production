# 环境变量
NODE_ENV = production

# 网站标题
VUE_APP_TITLE = 达世界

# vue 环境变量
VUE_APP_ENV = production

# 是否启用反调试功能（阻止开发者工具和F12调试）true开启/false关闭
VUE_APP_DEBUGGING = false

# 打包时是否生成 ./afwd123d.js 即站点配置文件(随机名称)，如果为false，不会生成独立配置文件
VUE_APP_CONFIGJS = false

# 打包后的 ./afwd123d.js 即站点配置文件 是否混淆, VUE_APP_CONFIGJS 为true时才生效
VUE_APP_OBFUSCATION = true

# CDN 静态资源前缀（可选）
# 设置后所有 JS/CSS/图片/字体等静态资源将从该 CDN 域名加载
# 运行时配置文件（随机名.js）始终留在源站，不走 CDN
# 示例：VITE_CDN_URL = https://cdn.example.com/ez-theme/
# 留空或注释掉则使用相对路径，与原行为一致
VITE_CDN_URL = https://dwc-1256539025.file.myqcloud.com/v2ez/0.4.0/dist/
